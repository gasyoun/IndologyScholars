review/

# ---- Nagari Google Group archive (closed list: 2,333 real emails + private bodies) ----
# The raw Takeout dump (1.88 GB mbox + members.csv) and the built SQLite DB are
# NEVER committed. Only curated/derived outputs may be published, and only after
# a /publish-safety-check GO (third-party members joined a *closed* list).
nagari-2005-2026/
nagari/data/
# The retrospective page is the ONE published artifact: it embeds aggregate stats
# and thread subjects only, and carries no email addresses at all (verified by
# nagari/scripts/audit_publish_surface.py). Everything else under site/ stays out.
nagari/site/*
!nagari/site/index.html
# The Markdown mirror carries full message bodies and is NOT redacted: the audit
# finds 1,290 distinct third-party addresses across 42,421 occurrences. It cannot
# be published until export_md.py redacts the way page.py already does.
nagari/md/
nagari/**/__pycache__/
